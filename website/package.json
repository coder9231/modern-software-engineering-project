{
  "name": "se-lab-web-legacy-entry",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Compatibility entry; maintained web source is packages/web and dependencies are installed at the repository root.",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "install:ci": "npm --prefix .. ci",
    "dev": "node ../scripts/legacy-web.mjs dev",
    "build": "node ../scripts/legacy-web.mjs build",
    "start": "node ../scripts/legacy-web.mjs start",
    "lint": "npm --prefix .. run lint -w @se-lab/web",
    "typecheck": "npm --prefix .. run typecheck -w @se-lab/web"
  }
}
