# Sensitive local configuration; keep placeholder examples trackable.
.env
.env.*
!.env.example
!.env.*.example

# OS and temporary files.
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.swp
*~

# Common dependencies and generated output; refine after choosing a stack.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
dist/
build/
coverage/

# Website build/ contains maintained platform integration sources.
!/website/build/
/website/build/*
!/website/build/*.ts
!/website/build/connector-preview-plugin.mjs
!/website/build/connector-preview-worker.mjs
!/website/build/sites-vite-plugin.LICENSE

# Disposable website deployment archive and checkout-local runtime state.
/website-deployment.tar.gz
/website/.sites-runtime/
/website/.wrangler/
/website/.next/
/website/.vinext/
/website/*.tsbuildinfo
/website/outputs/
/website/work/
/website/.agents/
/website/.codex/
/website-deployment-*.tar.gz

# Generated code-count reports.
reports/

# Local course datasets and transcribed course material are not published.
/testcase1/
/testcase2/
/testcase3/
/docs/course-photo-notes-2026-10-14.md
/docs/ppt-study/
/output/
/tmp/

# Workspace tooling, generated OCR resources and test output.
.workspace-runtime/
playwright-report/
test-results/
**/.sites-runtime/
**/.wrangler/
**/.next/
**/.vinext/
**/*.tsbuildinfo
/packages/web/public/ocr/
/packages/cli/dist/
!/packages/web/build/
/packages/web/build/*
!/packages/web/build/*.ts
!/packages/web/build/connector-preview-plugin.mjs
!/packages/web/build/connector-preview-worker.mjs
!/packages/web/build/sites-vite-plugin.LICENSE
.baseline/
